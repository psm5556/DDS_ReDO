# DDS ReDO 서버 설정 예시 — 이 파일을 .env 로 복사해 값을 채운다 (.env는 git에 올리지 않음)

# 기본
REDO_ENV=dev                         # dev / test / prod
REDO_DATABASE_URL=sqlite:///./redo.db
REDO_SECRET_KEY=change-me            # 운영 필수 (세션·AI 확인 카드 서명)
REDO_AUTH_MODE=mock                  # 운영: corporate (사내 로그인 연계)

# ---- 사내 LLM (DDS Conversa) — 아래 두 줄만 채우면 AI 도우미가 켜진다 ----
REDO_LLM_BASE_URL=                   # 예) http://ollama.사내도메인:11434
REDO_LLM_MODEL=                      # 예) qwen2.5:14b  (ollama list 에 보이는 이름, 도구 호출(tools) 지원 모델)
# REDO_LLM_PROVIDER=ollama           # ollama(기본) / openai (OpenAI 호환 게이트웨이: /v1/chat/completions)
# REDO_LLM_API_KEY=                  # 게이트웨이가 키를 요구할 때만
# REDO_LLM_TIMEOUT_SEC=120
# REDO_LLM_TEMPERATURE=0.1
# REDO_LLM_NUM_CTX=16384             # Ollama 문맥 길이 (도구 설명 포함, 8k 이상 권장)
# REDO_LLM_MAX_STEPS=6               # 한 요청에서 도구를 부를 수 있는 최대 횟수

# ---- MCP 서버 (/mcp, 개인 토큰으로 접속) ----
# REDO_MCP_ENABLED=true   # false로 끄면 /mcp·개인 토큰·'MCP 연결' 버튼이 모두 막힌다

# ---- TabPFN (실험적) ----
# REDO_TABPFN_ENABLED=false
# REDO_TABPFN_MODEL_PATH=
# REDO_TABPFN_MODEL_SHA256=
